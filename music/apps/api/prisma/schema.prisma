// Prisma schema file for PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  name            String?
  password        String
  role            Role             @default(USER)
  avatarUrl       String?
  likes           Like[]
  playlists       Playlist[]
  activities      UserActivity[]
  favoriteAlbums  FavoriteAlbum[]
  favoriteArtists FavoriteArtist[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("users")
}

model Artist {
  id        String           @id @default(uuid())
  name      String
  bio       String?
  imageUrl  String?
  tracks    Track[]
  albums    Album[]
  favorites FavoriteArtist[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("artists")
}

model Album {
  id                   String          @id @default(uuid())
  title                String
  coverUrl             String?
  releaseDate          DateTime?
  scheduledReleaseDate DateTime?
  isPublished          Boolean         @default(true)
  genre                String?
  artistId             String
  artist               Artist          @relation(fields: [artistId], references: [id], onDelete: Cascade)
  tracks               Track[]
  favorites            FavoriteAlbum[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@map("albums")
}

model Track {
  id                   String          @id @default(uuid())
  title                String
  audioUrl             String
  videoUrl             String?         // Optional video stream URL or YouTube embed ID
  duration             Int             // In seconds
  playCount            Int             @default(0)
  lyrics               String?         // Timestamped LRC lyrics string
  genre                String?         // Music Genre (e.g. Synthwave, Lofi, Pop, EDM)
  mood                 String?         // Mood Tag (e.g. Chill, Focus, Workout, Party)
  scheduledReleaseDate DateTime?
  isPublished          Boolean         @default(true)
  artistId             String
  artist               Artist          @relation(fields: [artistId], references: [id], onDelete: Cascade)
  albumId              String?
  album                Album?          @relation(fields: [albumId], references: [id], onDelete: SetNull)
  likes                Like[]
  playlistTracks       PlaylistTrack[]
  activities           UserActivity[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@map("tracks")
}

model Like {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, trackId])
  @@map("likes")
}

model Playlist {
  id          String          @id @default(uuid())
  title       String
  description String?
  coverUrl    String?
  isPublic    Boolean         @default(true)
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks      PlaylistTrack[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("playlists")
}

model PlaylistTrack {
  id         String   @id @default(uuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  trackId    String
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  order      Int      // To support manual playlist track ordering
  createdAt  DateTime @default(now())

  @@unique([playlistId, trackId])
  @@map("playlist_tracks")
}

model UserActivity {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId     String
  track       Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  progress    Int      @default(0) // Seconds played, for Continue Listening
  playedAt    DateTime @default(now()) @updatedAt
  isCompleted Boolean  @default(false)

  @@map("user_activities")
}

model FavoriteAlbum {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  albumId   String
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, albumId])
  @@map("favorite_albums")
}

model FavoriteArtist {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artistId  String
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, artistId])
  @@map("favorite_artists")
}
