{
  "name": "netflix-clone-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade Netflix-inspired video streaming platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@netflix/web --workspace=@netflix/api",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "npm --prefix apps/api run dev",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "test": "npm run test --workspaces",
    "db:generate": "npm --prefix packages/database run db:generate",
    "db:push": "npm --prefix packages/database run db:push",
    "db:seed": "npm --prefix packages/database run db:seed"
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "ecdsa-sig-formatter": "^1.0.11",
    "tslib": "^2.8.1"
  }
}
