# Global Environment Configuration Template
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/netflix_db?schema=public"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication & Security
JWT_SECRET=super-secret-netflix-clone-jwt-key-2026-production-secure
JWT_EXPIRATION=15m
REFRESH_TOKEN_SECRET=super-secret-refresh-token-key-2026-production-secure
REFRESH_TOKEN_EXPIRATION=7d

# Storage Provider (local | s3 | r2)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
S3_BUCKET_NAME=netflix-media-assets
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Payments Configuration (Stripe Sandbox)
STRIPE_SECRET_KEY=sk_test_mock_key
STRIPE_WEBHOOK_SECRET=whsec_mock_key

# Public App URLs
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
