# Port configuration
PORT=3000

# Daily alert schedule (standard 5-part cron syntax, default 08:00 AM)
CRON_SCHEDULE=0 8 * * *

# Sender address shown on outgoing alerts
EMAIL_FROM=alerts@nigeriacalendar.org

# Option 1: Resend API (Recommended modern dev provider)
# RESEND_API_KEY=re_123456789

# Option 2: SendGrid API
# SENDGRID_API_KEY=SG.xxxxxxxxxxxx

# Option 3: Custom SMTP / Ethereal Email
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your_user
# SMTP_PASS=your_pass
# SMTP_SECURE=false

# If no third-party keys are provided, alerts are reliably dispatched to the
# interactive in-app Email Outbox Inspector in the Admin Portal for visual testing!
